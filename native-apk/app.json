{
  "expo": {
    "name": "IFB Sync 2026",
    "slug": "ifb-sync-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ifbsync2026",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.ifb.sync2026",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysPermissionDescription": "Allow GeoTracker to access your location.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "./scripts/with-apk-splits.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03aab4fb-f037-488e-b2b8-d07ec78615f1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "najircode"
  }
}
